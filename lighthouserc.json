{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/calculator/index.html",
        "http://localhost/lp/keep-control/index.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*calculator)(?!.*keep-control).*$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.8 }],
            "total-blocking-time": ["error", { "maxNumericValue": 1000 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4000 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "categories:seo": ["warn", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "render-blocking-resources": "off",
            "uses-responsive-images": ["warn", {}],
            "unminified-javascript": "off",
            "unused-javascript": "off",
            "errors-in-console": "off",
            "csp-xss": "off"
          }
        },
        {
          "matchingUrlPattern": ".*calculator.*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.8 }],
            "total-blocking-time": ["error", { "maxNumericValue": 1000 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 5200 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "categories:seo": ["warn", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "render-blocking-resources": "off",
            "uses-responsive-images": ["warn", {}],
            "unminified-javascript": "off",
            "unused-javascript": "off",
            "errors-in-console": "off",
            "csp-xss": "off"
          }
        },
        {
          "matchingUrlPattern": ".*keep-control.*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.8 }],
            "total-blocking-time": ["error", { "maxNumericValue": 1000 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 4000 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:seo": "off",
            "is-crawlable": "off",
            "render-blocking-resources": "off",
            "uses-responsive-images": ["warn", {}],
            "unminified-javascript": "off",
            "unused-javascript": "off",
            "errors-in-console": "off",
            "csp-xss": "off"
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
